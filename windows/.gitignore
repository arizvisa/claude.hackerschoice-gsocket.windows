build/

# Defensive: stray intermediate files should only ever land under build/,
# but catch anything that escapes to windows/ itself (e.g. from an ad-hoc
# manual compile) rather than risk it getting committed.
*.obj
*.exe
*.lib

# Manual fallback scripts - kept on disk for convenience, never tracked.
# The real, dependency-tracked build is windows/Makefile (nmake) and
# windows/gsocket.proj (msbuild).
build-openssl.bat
build-lib.bat
build-tunnel.bat
build-gs-netcat.bat
